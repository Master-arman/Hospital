{
  "version": 2,
  "builds": [
    {
      "src": "backend/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "app/hospital-app/home-page/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/index.js"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "/backend/index.js"
    },
    {
      "src": "/",
      "dest": "/app/hospital-app/home-page/home.html"
    },
    {
      "src": "/(.*)",
      "dest": "/app/hospital-app/home-page/$1"
    }
  ]
}
