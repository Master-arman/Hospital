{
  "version": 2,
  "builds": [
    {
      "src": "backend/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "app/hospital-app/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "app/hospital-app/dist/hospital-app"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/index.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/app/hospital-app/dist/hospital-app/index.html"
    }
  ]
}
